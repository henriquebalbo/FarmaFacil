<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FarmaFacil.Views.UnidadesPage"
             Title="Unidades com Estoque"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="#1565C0" Padding="20,16">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="← Voltar"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="14"
                        Command="{Binding VoltarCommand}"/>
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="💊 Farma Fácil"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding NomeMedicamento}"
                           FontSize="13" TextColor="#BBDEFB"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- SUBTÍTULO + BOTÃO LOCALIZAÇÃO -->
        <Grid Grid.Row="1" BackgroundColor="White" Padding="16,14" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Unidades com estoque disponível"
               FontSize="15" FontAttributes="Bold" TextColor="#1A237E"/>
                <Label Text="{Binding StatusLocalizacao}"
               FontSize="12" TextColor="#90A4AE"/>
            </VerticalStackLayout>
                <Button Grid.Column="1"
                    Text="📍 Usar minha localização"
                    BackgroundColor="#E3F2FD"
                    TextColor="#1565C0"
                    FontSize="12"
                    CornerRadius="8"
                    Padding="12,8"
                    IsVisible="{Binding BuscandoLocalizacao,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding UsarLocalizacaoCommand}"/>
            <ActivityIndicator Grid.Column="1"
                       IsRunning="{Binding BuscandoLocalizacao}"
                       IsVisible="{Binding BuscandoLocalizacao}"
                       Color="#1565C0"/>
        </Grid>

        <!-- LOADING -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding Carregando}"
                           IsVisible="{Binding Carregando}"
                           Color="#1565C0"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

        <!-- SEM RESULTADOS -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding SemResultados}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="😔" FontSize="48" HorizontalOptions="Center"/>
            <Label Text="Nenhuma unidade com estoque"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#607D8B" HorizontalOptions="Center"/>
            <Label Text="Este medicamento não está disponível no momento"
                   FontSize="13" TextColor="#90A4AE" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- LISTA DE UNIDADES -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Unidades}"
                        Margin="16,12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="0"
                            StrokeThickness="1" Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White">
                        <VerticalStackLayout Padding="16" Spacing="8">

                            <!-- Nome -->
                            <Label Text="{Binding NomeUnidade}"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="#1A237E"/>

                            <!-- Endereço -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="📍" FontSize="13"/>
                                <Label Text="{Binding Endereco}"
                                       FontSize="13" TextColor="#607D8B"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Horário -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="🕐" FontSize="13"/>
                                <Label Text="{Binding HorarioFuncionamento}"
                                       FontSize="13" TextColor="#607D8B"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Estoque + Botão -->
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{Binding CorEstoque}"
                                    Padding="12,6"
                                      HorizontalOptions="Start">
                                    <Label TextColor="White" FontSize="13" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="✅ "/>
                                                <Span Text="{Binding QuantidadeDisponivel}"/>
                                                <Span Text=" unidades"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>

                                <Button Grid.Column="1"
                                        Text="🗺️"
                                        BackgroundColor="#E8F5E9"
                                        TextColor="#2e7d32"
                                        FontSize="16"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.AbrirMapsCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="2"
                                        Text="Detalhes"
                                        BackgroundColor="#1565C0"
                                        TextColor="White"
                                        FontSize="13"
                                        CornerRadius="8"
                                        Padding="14,8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.VerDetalhesCommand}"
                                        CommandParameter="{Binding .}"/>                
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>